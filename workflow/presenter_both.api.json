{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "Flux 2 Klein 9B distilled"},
    "inputs": {
      "unet_name": "flux-2-klein-9b-fp8.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Qwen3 8B"},
    "inputs": {
      "clip_name": "qwen_3_8b_fp8mixed.safetensors",
      "type": "flux2"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "Flux 2 VAE"},
    "inputs": {"vae_name": "flux2-vae.safetensors"}
  },
  "14": {
    "class_type": "LoadImage",
    "_meta": {"title": "Person"},
    "inputs": {"image": "person.png"}
  },
  "15": {
    "class_type": "LoadImage",
    "_meta": {"title": "Imported room"},
    "inputs": {"image": "background.png"}
  },
  "20": {
    "class_type": "ImageScaleToMaxDimension",
    "_meta": {"title": "Fit the person"},
    "inputs": {"image": ["14", 0], "upscale_method": "lanczos", "largest_size": 768}
  },
  "21": {
    "class_type": "ImageScaleToMaxDimension",
    "_meta": {"title": "Fit the room"},
    "inputs": {"image": ["15", 0], "upscale_method": "lanczos", "largest_size": 768}
  },
  "16": {
    "class_type": "VAEEncode",
    "_meta": {"title": "Person reference"},
    "inputs": {"pixels": ["20", 0], "vae": ["3", 0]}
  },
  "17": {
    "class_type": "VAEEncode",
    "_meta": {"title": "Room reference"},
    "inputs": {"pixels": ["21", 0], "vae": ["3", 0]}
  },
  "4": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Presenter"},
    "inputs": {
      "text": "Keep the face from the first image and the room from the second.",
      "clip": ["2", 0]
    }
  },
  "18": {
    "class_type": "ReferenceLatent",
    "_meta": {"title": "First image, the person"},
    "inputs": {"conditioning": ["4", 0], "latent": ["16", 0]}
  },
  "19": {
    "class_type": "ReferenceLatent",
    "_meta": {"title": "Second image, the room"},
    "inputs": {"conditioning": ["18", 0], "latent": ["17", 0]}
  },
  "5": {
    "class_type": "ConditioningZeroOut",
    "_meta": {"title": "Empty negative"},
    "inputs": {"conditioning": ["19", 0]}
  },
  "6": {
    "class_type": "EmptyFlux2LatentImage",
    "_meta": {"title": "768"},
    "inputs": {"width": 768, "height": 768, "batch_size": 1}
  },
  "7": {
    "class_type": "Flux2Scheduler",
    "_meta": {"title": "4 steps"},
    "inputs": {"steps": 4, "width": 768, "height": 768}
  },
  "8": {
    "class_type": "KSamplerSelect",
    "_meta": {"title": "Euler"},
    "inputs": {"sampler_name": "euler"}
  },
  "9": {
    "class_type": "CFGGuider",
    "_meta": {"title": "CFG 1"},
    "inputs": {
      "model": ["1", 0],
      "positive": ["19", 0],
      "negative": ["5", 0],
      "cfg": 1
    }
  },
  "10": {
    "class_type": "RandomNoise",
    "_meta": {"title": "Seed"},
    "inputs": {"noise_seed": 1}
  },
  "11": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "Sample"},
    "inputs": {
      "noise": ["10", 0],
      "guider": ["9", 0],
      "sampler": ["8", 0],
      "sigmas": ["7", 0],
      "latent_image": ["6", 0]
    }
  },
  "12": {
    "class_type": "VAEDecode",
    "_meta": {"title": "Decode"},
    "inputs": {"samples": ["11", 0], "vae": ["3", 0]}
  },
  "13": {
    "class_type": "SaveImage",
    "_meta": {"title": "Start frame"},
    "inputs": {
      "images": ["12", 0],
      "filename_prefix": "presenter/Podcast-Video-Maker-Workflow"
    }
  }
}
