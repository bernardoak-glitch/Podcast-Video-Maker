{
  "1": {
    "class_type": "UNETLoader",
    "_meta": {"title": "LTX 2.5 Distilled"},
    "inputs": {
      "unet_name": "ltx-2.5-22b-distilled-transformer-comfy-int8-convrot.safetensors",
      "weight_dtype": "default"
    }
  },
  "2": {
    "class_type": "CLIPLoader",
    "_meta": {"title": "Gemma on GPU"},
    "inputs": {
      "clip_name": "gemma4-12b-with-proj-ltx-2.5-comfy-int8-convrot.safetensors",
      "type": "ltxv",
      "device": "default"
    }
  },
  "3": {
    "class_type": "VAELoader",
    "_meta": {"title": "LTX video VAE"},
    "inputs": {"vae_name": "ltx-2.5-video-vae-bf16.safetensors"}
  },
  "4": {
    "class_type": "VAELoader",
    "_meta": {"title": "LTX audio VAE"},
    "inputs": {"vae_name": "ltx-2.5-audio-vae-bf16.safetensors"}
  },
  "7": {
    "class_type": "LoadImage",
    "_meta": {"title": "Portrait"},
    "inputs": {"image": "portrait.png"}
  },
  "8": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Performance"},
    "inputs": {
      "clip": ["2", 0],
      "text": "A presenter seated at a broadcast desk, speaking directly to the camera. Locked-off medium close-up. Calm, confident expression. Natural mouth shapes that follow the speech. Small head movement. Both hands rest on the desk. The presenter remains seated. Realistic skin, even broadcast lighting, sharp focus, clean background."
    }
  },
  "9": {
    "class_type": "CLIPTextEncode",
    "_meta": {"title": "Negative"},
    "inputs": {
      "clip": ["2", 0],
      "text": "blurry, overexposed, watermark, subtitles, extra fingers, deformed face, extra limbs, closed mouth, identity change, cartoon, video game"
    }
  },
  "10": {
    "class_type": "LTXVConditioning",
    "_meta": {"title": "24 fps"},
    "inputs": {
      "positive": ["8", 0],
      "negative": ["9", 0],
      "frame_rate": 24
    }
  },
  "11": {
    "class_type": "ResizeImageMaskNode",
    "_meta": {"title": "768 by 512"},
    "inputs": {
      "input": ["7", 0],
      "resize_type": "scale dimensions",
      "resize_type.width": 768,
      "resize_type.height": 512,
      "resize_type.crop": "center",
      "scale_method": "area"
    }
  },
  "12": {
    "class_type": "LTXVPreprocess",
    "_meta": {"title": "Compress the still"},
    "inputs": {
      "image": ["11", 0],
      "img_compression": 18
    }
  },
  "13": {
    "class_type": "EmptyLTXVLatentVideo",
    "_meta": {"title": "121 frames"},
    "inputs": {
      "width": 768,
      "height": 512,
      "length": 121,
      "batch_size": 1
    }
  },
  "14": {
    "class_type": "LTXVImgToVideoInplace",
    "_meta": {"title": "Hold the first frame"},
    "inputs": {
      "vae": ["3", 0],
      "image": ["12", 0],
      "latent": ["13", 0],
      "strength": 0.7,
      "bypass": false
    }
  },
  "24": {
    "class_type": "KokoroSpeaker",
    "_meta": {"title": "Voice"},
    "inputs": {"speaker_name": "bf_emma"}
  },
  "25": {
    "class_type": "KokoroGenerator",
    "_meta": {"title": "Script"},
    "inputs": {
      "text": "Good evening. Here is a short update from the studio.",
      "speaker": ["24", 0],
      "speed": 1,
      "lang": "English (British)"
    }
  },
  "26": {
    "class_type": "TrimAudioDuration",
    "_meta": {"title": "Match the 121 frames"},
    "inputs": {
      "audio": ["25", 0],
      "start_index": 0,
      "duration": 5.04
    }
  },
  "27": {
    "class_type": "LTXVAudioVAEEncode",
    "_meta": {"title": "Speech latent"},
    "inputs": {
      "audio": ["26", 0],
      "audio_vae": ["4", 0]
    }
  },
  "28": {
    "class_type": "LTXVFreezeLatent",
    "_meta": {"title": "Keep the spoken audio"},
    "inputs": {"latent": ["27", 0]}
  },
  "29": {
    "class_type": "LTXVConcatAVLatent",
    "_meta": {"title": "Picture plus speech"},
    "inputs": {
      "video_latent": ["14", 0],
      "audio_latent": ["28", 0]
    }
  },
  "30": {
    "class_type": "DisTorchPurgeVRAMV2",
    "_meta": {"title": "Unload encoders before the sample"},
    "inputs": {
      "anything": ["29", 0],
      "purge_cache": true,
      "purge_models": true,
      "purge_seedvr2_models": false,
      "purge_qwen3vl_models": false,
      "purge_nunchaku_models": false
    }
  },
  "31": {
    "class_type": "LTXVDualCFGGuider",
    "_meta": {"title": "CFG 1"},
    "inputs": {
      "model": ["1", 0],
      "positive": ["10", 0],
      "negative": ["10", 1],
      "video_cfg": 1,
      "audio_cfg": 1
    }
  },
  "32": {
    "class_type": "KSamplerSelect",
    "_meta": {"title": "euler ancestral"},
    "inputs": {"sampler_name": "euler_ancestral"}
  },
  "33": {
    "class_type": "ManualSigmas",
    "_meta": {"title": "Distilled 8 steps"},
    "inputs": {"sigmas": "1.0, 0.99375, 0.9875, 0.98125, 0.975, 0.909375, 0.725, 0.421875, 0.0"}
  },
  "34": {
    "class_type": "RandomNoise",
    "_meta": {"title": "Seed"},
    "inputs": {"noise_seed": 20261016}
  },
  "35": {
    "class_type": "SamplerCustomAdvanced",
    "_meta": {"title": "Sample"},
    "inputs": {
      "noise": ["34", 0],
      "guider": ["31", 0],
      "sampler": ["32", 0],
      "sigmas": ["33", 0],
      "latent_image": ["30", 0]
    }
  },
  "36": {
    "class_type": "LTXVSeparateAVLatent",
    "_meta": {"title": "Split picture and audio"},
    "inputs": {"av_latent": ["35", 0]}
  },
  "37": {
    "class_type": "VAEDecodeTiled",
    "_meta": {"title": "Decode"},
    "inputs": {
      "samples": ["36", 0],
      "vae": ["3", 0],
      "tile_size": 256,
      "overlap": 64,
      "temporal_size": 64,
      "temporal_overlap": 8
    }
  },
  "22": {
    "class_type": "CreateVideo",
    "_meta": {"title": "24 fps"},
    "inputs": {
      "images": ["37", 0],
      "audio": ["26", 0],
      "fps": 24,
      "bit_depth": "auto",
      "color_space": "sRGB",
      "codec": "none"
    }
  },
  "23": {
    "class_type": "SaveVideo",
    "_meta": {"title": "Save the take"},
    "inputs": {
      "video": ["22", 0],
      "filename_prefix": "video/Podcast-Video-Maker-Workflow",
      "format": "auto",
      "format.codec": "auto",
      "codec": "auto"
    }
  }
}
